FrameWidgetClass rootFrame {
 position 0 0
 size 1 36
 halign center_ref
 hexactpos 0
 vexactpos 1
 hexactsize 0
 vexactsize 1
 {
  PanelWidgetClass MarkerPanel {
   ignorepointer 1
   color 0.0275 0.0353 0.0471 0.9
   position 0 0
   size 0.96 0.88
   halign center_ref
   valign center_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   style rover_sim_colorable
   {
    ButtonWidgetClass Marker {
     position 0 0
     size 1 1
     halign center_ref
     valign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     {
      ImageWidgetClass MarkerIcon {
       ignorepointer 1
       position 10 0
       size 20 20
       valign center_ref
       hexactpos 1
       vexactpos 0
       hexactsize 1
       vexactsize 1
       mode blend
       "src alpha" 1
       stretch 1
      }
      TextWidgetClass MarkerName {
       ignorepointer 1
       color 0.8235 0.8784 0.9608 1
       position 38 0
       size 0.75 0.9
       valign center_ref
       hexactpos 1
       vexactpos 0
       hexactsize 0
       vexactsize 0
       text "Marker Name"
       font "BasicMap/gui/fonts/Oswald-Regular/Oswald-Regular"
       "exact text" 1
       "text valign" center
      }
     }
    }
   }
  }
 }
}
