FrameWidgetClass rootFrame {
 visible 1
 clipchildren 0
 ignorepointer 1
 position 20 20
 size 200 200
 hexactpos 1
 vexactpos 1
 hexactsize 1
 vexactsize 1
 {
  PanelWidgetClass Background {
   ignorepointer 1
   color 0.05 0.08 0.12 0.7
   position 0 0
   size 1 1
   halign center_ref
   valign center_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   style rover_sim_colorable
  }
  PanelWidgetClass BorderTop {
   ignorepointer 1
   color 0.25 0.55 0.85 0.85
   position 0 0
   size 1 2
   halign center_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 1
   style rover_sim_colorable
  }
  PanelWidgetClass BorderBottom {
   ignorepointer 1
   color 0.25 0.55 0.85 0.85
   position 0 0
   size 1 2
   halign center_ref
   valign bottom_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 1
   style rover_sim_colorable
  }
  PanelWidgetClass BorderLeft {
   ignorepointer 1
   color 0.25 0.55 0.85 0.85
   position 0 2
   size 2 196
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   style rover_sim_colorable
  }
  PanelWidgetClass BorderRight {
   ignorepointer 1
   color 0.25 0.55 0.85 0.85
   position 0 2
   size 2 196
   halign right_ref
   hexactpos 0
   vexactpos 1
   hexactsize 1
   vexactsize 1
   style rover_sim_colorable
  }
  FrameWidgetClass MapContainer {
   clipchildren 1
   ignorepointer 1
   position 4 4
   size 192 192
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   {
    MapWidgetClass MinimapWidget {
     ignorepointer 1
     position 0 0
     size 1 1
     halign center_ref
     valign center_ref
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
    }
   }
  }
  FrameWidgetClass MarkerContainer {
   ignorepointer 1
   position 0 0
   size 1 1
   halign center_ref
   valign center_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   {
    ImageWidgetClass PlayerMarker {
     visible 1
     ignorepointer 1
     position 0 0
     size 24 24
     halign center_ref
     valign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     image0 "BasicMap/gui/images/dayzarrow.paa"
     mode blend
     "src alpha" 1
     stretch 1
    }
   }
  }
  TextWidgetClass CoordinatesText {
   ignorepointer 1
   color 0.85 0.92 1 1
   position 0 3
   size 1 20
   halign center_ref
   valign bottom_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 1
   text "0000 / 0000"
   font "BasicMap/gui/fonts/Oswald-Regular/Oswald-Regular"
   "shadow size" 1
   "shadow color" 0 0 0 0.85
   "shadow offset" 1 1
   "exact text" 1
   "exact text size" 12
   "text halign" center
   "text valign" center
  }
  TextWidgetClass RadiusText {
   ignorepointer 1
   color 0.6 0.75 0.9 0.7
   position 4 4
   size 50 16
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   text "400m"
   font "BasicMap/gui/fonts/Oswald-Regular/Oswald-Regular"
   "exact text" 1
   "exact text size" 10
   "text halign" left
   "text valign" top
  }
 }
}