FrameWidgetClass rootFrame {
 clipchildren 0
 ignorepointer 1
 position 0 0
 size 0 0
 hexactpos 1
 vexactpos 1
 hexactsize 1
 vexactsize 1
 {
  FrameWidgetClass Marker {
   clipchildren 0
   ignorepointer 1
   position 0 -12
   size 0 0
   hexactpos 1
   vexactpos 1
   hexactsize 1
   vexactsize 1
   {
    PanelWidgetClass MarkerPanel {
     clipchildren 0
     ignorepointer 1
     position 0 0
     size 200 80
     halign center_ref
     hexactpos 1
     vexactpos 1
     hexactsize 1
     vexactsize 1
     {
      ImageWidgetClass Icon {
       clipchildren 0
       ignorepointer 1
       position 0 0
       size 20 20
       halign center_ref
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       mode blend
       "src alpha" 1
       stretch 1
      }
      TextWidgetClass Name {
       clipchildren 0
       ignorepointer 1
       color 0.9412 0.9608 0.9882 1
       position 0 22
       size 200 24
       halign center_ref
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       text "Marker"
       font "BasicMap/gui/fonts/Oswald-Medium/Oswald-Medium"
       "exact text" 0
       "text halign" center
       "shadow size" 14
       "shadow offset" 1 1
       "shadow color" 0 0 0 0.85
      }
      TextWidgetClass Distance {
       clipchildren 0
       ignorepointer 1
       color 0.7059 0.8392 0.9804 1
       position 0 46
       size 200 22
       halign center_ref
       hexactpos 1
       vexactpos 1
       hexactsize 1
       vexactsize 1
       text ""
       font "BasicMap/gui/fonts/Oswald-Regular/Oswald-Regular"
       "exact text" 0
       "text halign" center
       "shadow size" 12
       "shadow offset" 1 1
       "shadow color" 0 0 0 0.85
      }
     }
    }
   }
  }
 }
}
